apiVersion: 1

# Скопировать в contactpoints.yml (без .example) и подставить реальные
# значения — сам contactpoints.yml гитигнорится (секрет, как .env-файлы).
# bottoken/chatid — из @BotFather и https://api.telegram.org/bot<TOKEN>/getUpdates
contactPoints:
  - orgId: 1
    name: telegram
    receivers:
      - uid: telegram-default
        type: telegram
        settings:
          bottoken: "REPLACE_ME_BOT_TOKEN"
          chatid: "REPLACE_ME_CHAT_ID"
          parse_mode: "HTML"
        disableResolveMessage: false
